# ============================================================================
# Blood MVP - environment variables.  Copy to .env.local and fill in.
# NEVER commit .env.local. NEVER paste these values in chat.
# ============================================================================

# --- App ---------------------------------------------------------------
APP_ENV=local                         # local | staging | production
PUBLIC_APP_URL=http://localhost:3000  # staging/production: your https Vercel URL (no trailing slash)

# --- Supabase (Dashboard > Project Settings > API) -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY. Never expose to the browser.
SUPABASE_DB_URL=                      # only for scripts/backup.sh (Project Settings > Database > Connection string)
SEND_SMS_HOOK_SECRET=                 # Supabase > Auth > Hooks > Send SMS > generate secret (looks like v1,whsec_...)

# --- Our own secrets (generate with: npx tsx scripts/gen-secrets.ts) -------
CRON_SECRET=                          # must equal the Vault secret 'cron_secret' used by pg_cron
DATA_ENCRYPTION_KEY=                  # 32 random bytes, base64. Losing it = encrypted health data unreadable. BACK IT UP.

# --- Safety: who may be contacted when APP_ENV is not production -----------
# Comma-separated E.164 numbers. Empty = NOTHING is ever sent (safe default).
OUTBOUND_ALLOWLIST=

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
WHATSAPP_GRAPH_VERSION=v23.0          # use the version shown in Meta's current docs
WHATSAPP_PHONE_NUMBER_ID=1383758468156268             # NOT the phone number: the long "Phone number ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=2870087486701819
WHATSAPP_ACCESS_TOKEN=EAAPuDAWn1fUBS6PyZCb9zUSGxGZAgozHGeQBMRxpKZAGRtD0UVcbIth6NPj0rtKFJZAWfZA46ZCwn2ZArt3HbMyO4q0sUQLkJxX9sCz7dMT2wOr6TlE7D1xcOlKOF5NhoZCC9RIBvYYquFPdQ6t1t1uUs3ZAOf7GxoZCLVjZCPTCIpTNUwpfcaYSqSOqZBS5YhROUB7kXCEZCn9kIJHvtUjAvgXMbM0jlgoVe6sH1y9imZA2GmixiH5T3vKCTK0kVYVDKv62LiyJVoQ6P01EK4eEWwoPmq               # test: temporary (24h). production: permanent System User token
WHATSAPP_APP_SECRET=53e275f46d20ce53a0035b46d202ef7d                  # Meta App > Settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=                # any random string you choose; same value typed in Meta's webhook page

# --- Voice (Twilio) -----------------------------------------------------------
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                   # your Twilio trial/paid number, E.164

# --- Dev helpers ------------------------------------------------------------------
# JSON list used by scripts/seed-dev-donors.ts. ONLY real people who agreed (you + friends).
# Example: [{"name":"Siva","phone":"+919876543210","group":"O+","lat":17.0005,"lng":81.8040,"gender":"male","dob":"2003-01-01","weight":65}]
DEV_TEST_DONORS=

# --- Optional -----------------------------------------------------------------------
SENTRY_DSN=
